## 2.3 Flagging CTE Statuses

### a. Prep to Code CTE Statuses

Coding criteria:
  -   CTE Participant -  A student completing EITHER: Only one CTE course for any number of credits; OR More than one course for less than two credits (the student does not have to pass or receive credit).
  -   CTE Explorer - A student completing two or more high school CTE courses for a total of two or more credits and not a participant, concentrator or completer (the student does not have to pass or receive credit). 
  -   CTE Concentrator - A student completing and passing two or more CTE courses for a total of at least two credits within the same program of study and not a completer.
  -   CTE Completer - A student completing and passing three or more CTE courses for a total of four or more credits within a program of study, including one level three or level four course from within the same program of study. 
  
```{r}
#convert course level to numeric but selecting only the last character (which is the number)
cohort_pathways_table <- cohort_pathways_table %>%
  mutate(C_pathway_course_level = case_when(
    D_course_level == "Principles" ~ 1,
    D_course_level == "Concentrator A" | D_course_level == "Concentrator B" | D_course_level == "Tech Skills" | D_course_level == "Tech skills"~ 2,
    D_course_level == "Capstone" ~ 3)
  )


## Creating new variables 
cohort_pathways_table <- cohort_pathways_table %>%
  group_by(D_stu_id, C_pathway, D_course_id) %>% 
  mutate(
    H_passed_full_pathway_course = if_else(
      (any(D_term == "S1") & any(D_creds_earn >= 1 & D_term == "S1")) &
      (any(D_term == "S2") & any(D_creds_earn >= 1 & D_term == "S2")), 
      1, 
      if_else(
        n_distinct(D_term) == 1 & any(D_creds_earn >= 1), 
        1, 
        0
      )
    )
  ) %>%
  ungroup() %>% 
  mutate(H_pathway_course_level_passed = if_else(H_passed_full_pathway_course == 1, C_pathway_course_level, 0)) %>%
  ungroup() %>% 
  group_by(D_stu_id, C_pathway) %>% 
  mutate(H_max_course_level_passed = max(H_pathway_course_level_passed, na.rm = TRUE)) %>% 
  mutate(H_total_creds_earn = sum(as.numeric(D_creds_earn), na.rm = TRUE)) %>%
  ungroup() %>% 
  group_by(D_stu_id) %>% 
  mutate(H_max_creds_earn = max(H_total_creds_earn)) %>% 
  ungroup()

