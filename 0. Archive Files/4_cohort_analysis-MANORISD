# Pathways Analysis 

## High-level
```{r}
# Create a summary table of pathways credits possible
summary_table <- cohort_pathways_table %>%
  distinct(D_stu_id, .keep_all = TRUE) %>%
  group_by(H_total_pathway_creds_enrolled) %>%
  summarise(count_students = n(), .groups = 'drop') %>%
  mutate(percentage = round((count_students / sum(count_students)) * 100, 1)) %>%
  arrange(H_total_pathway_creds_enrolled)

# Calculate the grand total
grand_total <- summary_table %>%
  summarise(across(where(is.numeric), sum, na.rm = TRUE)) %>%
  mutate(H_total_creds_enrolled = "Total")

