    TRUE ~ D_stu_race
  ))
  
#create multiple pass-fail (credit recovery) flag
duplicate_pass_fail <- merged_transcript_cohort %>%
  group_by(D_stu_id, D_course_id) %>%
  filter(any(D_pass_fail == "Y") & any(D_pass_fail == "N")) %>%
  ungroup()

# View the result
print(duplicate_pass_fail)

#how many distinct students with duplicates?
duplicate_pass_fail %>%
  summarise(count = n_distinct(D_stu_id))

#Lets create a flag for these students to easily filter out their "yes" rows. First I want to tag every "Y" row for the "D_pass_fail" variable where a unique student also has an "N" for row for the same course. This new column should be called "credit_recovery_duplicate", and the "yes" flags should only be rows marked "Y" where a student also has a "N" row for the same course.
merged_transcript_cohort <- merged_transcript_cohort %>%
  group_by(D_stu_id, D_course_id) %>%
  mutate(credit_recovery_duplicate = ifelse(any(D_pass_fail == "Y") & any(D_pass_fail == "N") & D_pass_fail == "Y", "Y", "N")) %>%
  ungroup()

#and check that the flag worked by summing the number of rows marked "Y" for credit_recovery_duplicate
merged_transcript_cohort %>%
  filter(credit_recovery_duplicate == "Y") %>%
  summarise(count = n())

#great, so now that we have the flag we can filter it out later if we need to

#rename the original credits earned column to "C_credits_possible"
merged_transcript_cohort <- merged_transcript_cohort %>% 
  rename(C_credits_possible = D_creds_earn)

#create a new column that is overall credits earned, which groups by student ID and sums the credits earned for each course if D_pass_fail = "Y"
merged_transcript_cohort <- merged_transcript_cohort %>%
  mutate(C_earned_credits = (ifelse(D_pass_fail == "Y", 
  (C_credits_possible), 0)))

#Another column that is fixed credits to filter out the credit recovery duplicates
merged_transcript_cohort <- merged_transcript_cohort %>%
  mutate(C_credits_fixed = (ifelse(credit_recovery_duplicate == "N", as.numeric(C_credits_possible), 0)))

```
